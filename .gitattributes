# Normalize line endings: LF in the repository, native on checkout.
* text=auto eol=lf

*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.mp3 binary
*.wav binary
*.zip binary

# Keep release archives (git archive) lean.
.github         export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.distignore     export-ignore
.editorconfig   export-ignore
tests           export-ignore
docs/ci         export-ignore
phpcs.xml.dist  export-ignore
composer.lock   export-ignore
