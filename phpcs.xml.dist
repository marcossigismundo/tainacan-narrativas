<?xml version="1.0"?>
<ruleset name="Tainacan Narrativas">
	<description>Coding standards for the Tainacan Narrativas plugin.</description>

	<rule ref="WordPress-Core"/>
	<rule ref="WordPress-Docs"/>
	<rule ref="WordPress-Extra"/>
	<rule ref="WordPress.Security"/>

	<!--
		O standard "PluginCheck" não é distribuído via Composer — rode-o
		separadamente como verificação autoritativa do WordPress.org:
		    wp plugin check tainacan-narrativas
	-->

	<config name="testVersion" value="8.0-"/>
	<rule ref="PHPCompatibilityWP"/>

	<config name="minimum_wp_version" value="6.5"/>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="tainacan-narrativas"/>
			</property>
		</properties>
	</rule>

	<!-- Autoloader PSR-4 (TainacanNarrativas\Foo\Bar => includes/Foo/Bar.php), StudlyCase. -->
	<rule ref="WordPress.Files.FileName">
		<exclude-pattern>includes/*</exclude-pattern>
		<exclude-pattern>tests/*</exclude-pattern>
	</rule>

	<arg name="extensions" value="php"/>
	<arg value="ps"/>
	<arg name="colors"/>
	<file>.</file>

	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/assets/vendor/*</exclude-pattern>
	<exclude-pattern>*/languages/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
</ruleset>
